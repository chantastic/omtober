{
  "name": "omtober",
  "compatibility_date": "2026-10-01",
  // Static assets only — no Worker script.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "omtober.org", "custom_domain": true },
    { "pattern": "www.omtober.org", "custom_domain": true }
  ]
}
